# mac-monitor - zentrale Konfiguration. Datei nach .env kopieren.
# ALLE URLs kommen nur von hier. Keine hart codierten Adressen im Code.

MM_HOST=0.0.0.0
MM_PORT=8770
# Oeffentliche Basis-URL (ohne abschliessenden Slash).
MM_PUBLIC_URL=http://127.0.0.1:8770

# Testbetrieb: statisches Token ist bewusst akzeptiert.
MM_API_TOKEN=mac-monitor-test-token
MM_ALLOW_ANONYMOUS_READ=1

MM_DB_PATH=./data/mac-monitor.sqlite3
MM_MACHINES_FILE=./config/machines.json

MM_SAMPLE_INTERVAL=10
MM_OFFLINE_AFTER=45
MM_RESERVATION_TTL=120
MM_HEARTBEAT_TIMEOUT=90

MM_RETENTION_RAW_DAYS=14
MM_RETENTION_TPS_DAYS=30
MM_RETENTION_EVENT_DAYS=30

MM_RAM_HEADROOM_GB=2.0
MM_VRAM_HEADROOM_GB=0.5

# Scoring-Gewichte (Option C)
MM_W_VRAM=28
MM_W_RAM=22
MM_W_GPU_IDLE=14
MM_W_CPU_IDLE=8
MM_W_TPS=16
MM_W_MODEL_LOADED=12
MM_TPS_FALLBACK_DISCOUNT=0.6
