# Fleet Monitor Hardening (1.2.0) — zusammen mit den PHP-Dateien ins Web-Verzeichnis hochladen.
# Verhindert den Download von Datenbank, Logs und Konfiguration.

Options -Indexes

# SQLite-DB (inkl. WAL/SHM-Neben Dateien), Logs, Backups
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sqlite3|db|log|bak|lock|tmp|md)$">
    Require all denied
</FilesMatch>

# Includes — nie direkt im Browser aufrufbar
<Files "config.php">
    Require all denied
</Files>
<Files "auth.php">
    Require all denied
</Files>
<Files "secrets.php">
    Require all denied
</Files>
<Files "auth-v2.php">
    Require all denied
</Files>
# Gast-Freigaben (Notfall-Fallback im Webroot; regulär liegt die Datei außerhalb)
<FilesMatch "^freigaben\.json(\.tmp)?$">
    Require all denied
</FilesMatch>
<Files "webauthn-credentials.json">
    Require all denied
</Files>
<FilesMatch "^webauthn-credentials\.json(\.tmp)?$">
    Require all denied
</FilesMatch>
# Command-Queue nur über commands.php erreichbar
<FilesMatch "^commands\.json">
    Require all denied
</FilesMatch>

# Sicherheitsnetz für alles mit ht-Präfix (außer dieser Datei)
<FilesMatch "^\.ht(?!access)">
    Require all denied
</FilesMatch>

# Kein Caching fuer HTML/PHP — verhindert, dass der Browser veraltete Seiten
# ausliefert (z.B. den entfernten Slot-Planner Login-Overlay).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
