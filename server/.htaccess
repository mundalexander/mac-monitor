# mac-monitor Hardening — zusammen mit den PHP-Dateien ins Web-Verzeichnis hochladen.
# Verhindert den Download von Datenbank, Logs und Konfiguration.

Options -Indexes

# SQLite-DB (inkl. WAL/SHM-Neben Dateien), Logs, Backups
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log|bak)$">
    Require all denied
</FilesMatch>

# Includes — nie direkt im Browser aufrufbar
<Files "config.php">
    Require all denied
</Files>
<Files "auth.php">
    Require all denied
</Files>
<Files "secrets.php">
    Require all denied
</Files>

# Sicherheitsnetz für alles mit ht-Präfix (außer dieser Datei)
<FilesMatch "^\.ht(?!access)">
    Require all denied
</FilesMatch>

# Kein Caching fuer HTML/PHP — verhindert, dass der Browser veraltete Seiten
# ausliefert (z.B. den entfernten Slot-Planner Login-Overlay).
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
